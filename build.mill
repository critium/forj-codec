package build

import mill.*
import mill.api.BuildCtx
import mill.javalib.*
import mill.javalib.publish.*

/**
 * forj-codec builds against forj as published to ~/.m2 (`./mill __.publishM2Local` in the forj
 * repo). forj's jars are preview class files for one exact JDK build, so every module compiles,
 * tests and runs on that pinned JDK (bin/fetch-jdk) with preview features on.
 *
 * The traits below are copied from forj's build.mill and its "Using forj from another build"
 * recipe. Keep them in step with forj until they ship as a Mill plugin.
 */
val forjVersion = "0.1.0-SNAPSHOT"

/** .jdk/preview: the pinned JDK, with a `java` launcher that always adds --enable-preview. */
trait PinnedJdk extends JavaModule {
  def javaHome = Task.Input {
    val home = BuildCtx.workspaceRoot / ".jdk" / "preview"
    if (!os.exists(home / "bin" / "javac")) sys.error("missing pinned JDK: run bin/fetch-jdk")
    Some(PathRef(home, quick = true))
  }
}

/** Appends `flags` unless already there (test modules inherit their parent's javacOptions). */
def withFlags(options: Seq[String], flags: Seq[String]): Seq[String] =
  if (options.containsSlice(flags)) options else options ++ flags

/** javac internals the forj plugin uses: the compiler JVM needs them exported and opened. */
val forjCompilerJvmOptions =
  Seq("api", "code", "comp", "main", "parser", "tree", "util")
    .map(p => s"--add-exports=jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED") ++
  Seq("comp", "main", "util")
    .map(p => s"--add-opens=jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED")

/** A module whose sources use forj syntax: forj-core at runtime, forj-plugin in javac. */
trait ForjModule extends MavenModule with PinnedJdk {
  def repositories = super.repositories() ++ Seq("m2Local")
  def mvnDeps = super.mvnDeps() ++ Seq(mvn"forj:forj-core:$forjVersion")
  def compileMvnDeps = super.compileMvnDeps() ++ Seq(mvn"forj:forj-plugin:$forjVersion")
  def jvmOptions = super.jvmOptions() ++ forjCompilerJvmOptions
  def javacOptions = Task {
    withFlags(super.javacOptions(), Seq("--enable-preview", "--source", "28", "-Xplugin:Forj"))
  }
  // javadoc parses sources without the plugin, so it reads them as the plugin's text stage
  // rewrites them (F<A> as forj.Kind<F, A>, using clauses as @forj.Using parameters)
  def forjExportedSources = Task {
    val plugin = compileClasspath().filter(_.path.last.startsWith("forj-plugin-")).map(_.path)
    os.proc(
      javaHome().get.path / "bin" / "java", forjCompilerJvmOptions,
      "-cp", plugin.mkString(java.io.File.pathSeparator),
      "forj.plugin.ExportSources", Task.dest, allSources().map(_.path)
    ).call(stdout = os.Inherit)
    PathRef(Task.dest)
  }
  def docSources = Task { Seq(forjExportedSources()) }
  // some forj-core class files are preview class files, which javadoc reads only with these;
  // -Xdoclint:none because the javadoc here is prose, without @param/@return (broken links
  // are still reported); the look is critium.github.io's (docStyle below)
  def javadocOptions = Task {
    super.javadocOptions() ++ Seq("--enable-preview", "--source", "28", "-Xdoclint:none") ++
      docStyle.stylesheet().toSeq.flatMap(css => Seq("--add-stylesheet", css.path.toString))
  }
}

/**
 * The docs' look lives on critium.github.io (javadoc.css and the palette.css it imports), shared
 * by every critium repo's docs. Builds take a copy, palette inlined, because a javadoc jar is
 * read offline; docs hosted on Pages load it live instead (bin/publish-docs). Copied from
 * forj's README.
 *
 * FORJ_DOCS_STYLE=<checkout of critium.github.io> uses a local copy, to try a change before
 * publishing it. Unreachable (offline): javadoc's own look, with a warning.
 */
object docStyle extends Module {
  def site = "https://critium.github.io"

  def css: T[Option[String]] = Task.Input {
    def read(name: String): Option[String] = Task.env.get("FORJ_DOCS_STYLE") match {
      case Some(dir) => Some(os.Path(dir, BuildCtx.workspaceRoot) / name).filter(os.exists(_)).map(os.read(_))
      case None =>
        try {
          val r = requests.get(s"$site/$name", connectTimeout = 3000, readTimeout = 5000, check = false)
          if (r.statusCode == 200) Some(r.text()) else None
        } catch { case _: Exception => None }
    }
    val found = for (javadoc <- read("javadoc.css"); palette <- read("palette.css"))
      yield {
        // palette.css inlined; browsers ignore an @import after a rule, so imports go first
        val lines = javadoc.replace("@import url(\"palette.css\");", palette).linesIterator.toSeq
        val (imports, rules) = lines.partition(_.trim.startsWith("@import"))
        (imports ++ rules).mkString("", "\n", "\n")
      }
    if (found.isEmpty) Task.log.warn(s"forj: no docs stylesheet from ${Task.env.getOrElse("FORJ_DOCS_STYLE", site)}; javadoc's default look")
    found
  }

  /** Written under its content hash: Mill reruns javadoc when its options change, not a file's. */
  def stylesheet: T[Option[PathRef]] = Task {
    css().map { text =>
      val file = Task.dest / Integer.toHexString(text.hashCode) / "javadoc.css"
      os.write(file, text, createFolders = true)
      PathRef(file)
    }
  }
}

trait CodecPublish extends PublishModule {
  def publishVersion = forjVersion
  def pomSettings = PomSettings(
    description = "forj-codec: compile-time JSON codecs for forj",
    organization = "forj",
    url = "",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl(),
    developers = Seq()
  )
}

/** JUnit 5 tests; compiler options come from the enclosing module. */
trait CodecTests extends ForjModule with TestModule.Junit5 {
  def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"org.junit.jupiter:junit-jupiter:5.13.4",
    mvn"org.junit.platform:junit-platform-launcher:1.13.4"
  )
}

/** The SPI, the forj backend, Codec<A> and its instances. */
object json extends ForjModule with CodecPublish {
  def artifactName = "forj-json"

  object test extends MavenTests with CodecTests {
    def moduleDeps = super.moduleDeps ++ Seq(`json-tck`)
  }
}

/**
 * The backend TCK: tests every JsonBackend must pass, published so adapters in any repo run
 * them. A backend's test module extends JsonBackendTck and says which backend to test.
 */
object `json-tck` extends ForjModule with CodecPublish {
  def artifactName = "forj-json-tck"
  def moduleDeps = Seq(json)
  def mvnDeps = super.mvnDeps() ++ Seq(mvn"org.junit.jupiter:junit-jupiter-api:5.13.4")
}

/**
 * forj's JsonBackend on Jackson's streaming parser and generator (jackson-core only, no
 * databind), so the same codecs run on Jackson. It passes the same TCK as forj's backend.
 */
object `json-jackson` extends ForjModule with CodecPublish {
  def artifactName = "forj-json-jackson"
  def moduleDeps = Seq(json)
  def mvnDeps = super.mvnDeps() ++ Seq(mvn"com.fasterxml.jackson.core:jackson-core:2.22.3")

  object test extends MavenTests with CodecTests {
    def moduleDeps = super.moduleDeps ++ Seq(`json-tck`)
  }
}

/**
 * JMH micro-benchmarks: forj's codecs and backend against reference libraries on the same
 * records. Not published: the reference libraries (Jackson databind) never reach a published
 * module. Run with bin/bench.
 *
 * JMH's annotation processor can't run here: with any annotation processor active, javac
 * re-parses the sources without forj's parser, so forj syntax fails to compile (see forj's
 * TODO). Instead `bench` compiles with -proc:none, and `bench.harness` generates JMH's harness
 * from the compiled classes with JMH's bytecode generator, then compiles that plain Java.
 */
object bench extends ForjModule {
  def moduleDeps = Seq(json, `json-jackson`)
  def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"org.openjdk.jmh:jmh-core:1.37",
    mvn"com.fasterxml.jackson.core:jackson-databind:2.22.3",
    mvn"com.fasterxml.jackson.datatype:jackson-datatype-jsr310:2.22.3",
    mvn"com.fasterxml.jackson.datatype:jackson-datatype-jdk8:2.22.3"
  )
  def javacOptions = Task { super.javacOptions() ++ Seq("-proc:none") }

  /** JMH's harness for `bench`: generated sources and META-INF/BenchmarkList. Run this module. */
  object harness extends MavenModule with PinnedJdk {
    def moduleDeps = Seq(bench)
    def javacOptions = Seq("--enable-preview", "--source", "28")

    def generated = Task {
      val dest = Task.dest
      val cp = (generator.runClasspath() ++ bench.runClasspath()).map(_.path.toString).mkString(java.io.File.pathSeparator)
      val javaBin = (javaHome().get.path / "bin" / "java").toString
      os.proc(javaBin, "-cp", cp, "org.openjdk.jmh.generators.bytecode.JmhBytecodeGenerator",
        bench.compile().classes.path, dest / "src", dest / "resources", "default").call()
      PathRef(dest)
    }
    def generatedSources = Task { Seq(PathRef(generated().path / "src")) }
    def resources = Task { super.resources() ++ Seq(PathRef(generated().path / "resources")) }
  }

  /** JMH's bytecode generator, run by `harness.generated`. */
  object generator extends JavaModule with PinnedJdk {
    def mvnDeps = Seq(mvn"org.openjdk.jmh:jmh-generator-bytecode:1.37")
  }

  /** Checks that every library in a benchmark writes and reads the same JSON. */
  object test extends MavenTests with CodecTests
}
